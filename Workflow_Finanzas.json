    {
      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64 = buffer.toString('base64');\n\nreturn {\n  json: {\n    base64: base64,\n    mimeType: items[0].binary.data.mimeType,\n    caption: $('Telegram Trigger').item.json.message.caption || \"\"\n  }\n};"
      },
